# AI Provider Selection
# Supported values: gemini (default), venice, genspake, nvidia-nim, openrouter, huggingface
AI_PROVIDER=gemini

# Gemini (default provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Venice.AI (OpenAI-compatible)
VENICE_API_KEY=your_venice_api_key_here
VENICE_MODEL=venice-v2

# Genspake (OpenAI-compatible)
GENSPAKE_API_KEY=your_genspake_api_key_here
GENSPAKE_MODEL=genspake-image-1

# NVIDIA NIM (OpenAI-compatible image edits/generations)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://api.nvcf.nvidia.com/v2
NVIDIA_NIM_MODEL=stabilityai/stable-diffusion-3-5-large

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-image-1

# Hugging Face Inference (OpenAI-compatible)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-3-5-large

# Optional: API endpoint override (for testing/custom endpoints).
# Not yet wired into vite.config.ts; included for future use.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# Optional: Enable debug logging (true/false). Off by default.
# GEMINI_DEBUG=false
